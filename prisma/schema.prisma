// Enerifc の public スキーマ定義。方針は docs/database.md。
// Prisma CLI は 6.x（datasource に url を書く）。拡張機能が 7 系だと警告が出ることがある。
// auth は schemas に載せるが DDL はしない（prisma.config.ts の externalTables / DEC-21）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase はマイグレーションを Direct 接続（DIRECT_URL）で実行する
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// --- PostgreSQL enum（docs/database.md 4.2） ---

enum ProjectStatus {
  draft
  ifc_extracting
  review
  calculating
  completed
  failed

  @@map("project_status")
  @@schema("public")
}

enum CalculationResultStatus {
  draft
  calculating
  completed
  failed

  @@map("calculation_result_status")
  @@schema("public")
}

enum OverallGoalStatus {
  goal_achieved
  not_achieved

  @@map("overall_goal_status")
  @@schema("public")
}

enum DataSource {
  ifc_auto
  manual

  @@map("data_source")
  @@schema("public")
}

enum ExtractionStatus {
  pending
  running
  completed
  failed

  @@map("extraction_status")
  @@schema("public")
}

enum IfcElementKind {
  storey
  space
  slab
  wall
  roof
  floor_on_grade
  window
  door
  curtain_wall
  other

  @@map("ifc_element_kind")
  @@schema("public")
}

enum OpeningInputMethod {
  frame_and_glass
  frame_and_glass_performance
  window_performance

  @@map("opening_input_method")
  @@schema("public")
}

enum ApiRunStatus {
  pending
  completed
  error

  @@map("api_run_status")
  @@schema("public")
}

// --- 認証連携（B6）。auth.users は Prisma が DDL しない（DEC-21） ---

/// Supabase Auth の users。列は id だけ書く（外部テーブル）。アプリの業務コードからは使わない。
model AuthUser {
  id      String   @id @db.Uuid
  profile Profile?

  @@map("users")
  @@schema("auth")
}

/// 会社名。登録時の find-or-create は API 側（C3）。
model Company {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  profiles  Profile[]

  @@map("companies")
  @@schema("public")
}

/// アプリのユーザー行。id は auth.users(id) と同じ UUID。
model Profile {
  id          String    @id @db.Uuid
  companyId   BigInt?   @map("company_id")
  displayName String    @map("display_name") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  authUser    AuthUser  @relation(fields: [id], references: [id], onDelete: Cascade)
  projects    Project[]
  contactInquiries ContactInquiry[]

  @@index([companyId], map: "idx_profiles_company_id")
  @@map("profiles")
  @@schema("public")
}

// --- 案件（C2） ---

/// 建物案件。計算値は持たず project_calculation_results へ（後続フェーズ）。
model Project {
  id             BigInt        @id @default(autoincrement())
  userId         String        @map("user_id") @db.Uuid
  name           String        @db.VarChar(255)
  status         ProjectStatus @default(draft)
  programVersion String        @default("3.10") @map("program_version") @db.VarChar(20)
  totalFloorArea Decimal?      @map("total_floor_area") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)
  user           Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        MasterProgramVersion @relation(fields: [programVersion], references: [version])

  @@index([userId], map: "idx_projects_user_id")
  @@index([status], map: "idx_projects_status")
  @@map("projects")
  @@schema("public")
}

// --- お問い合わせ（C4） ---

/// お問い合わせフォーム送信。未ログインは user_id NULL（CTL-02）。
model ContactInquiry {
  id          BigInt    @id @default(autoincrement())
  userId      String?   @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  companyName String?   @map("company_name") @db.VarChar(255)
  email       String    @db.VarChar(255)
  content     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        Profile?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_contact_inquiries_user_id")
  @@map("contact_inquiries")
  @@schema("public")
}

// --- マスタ ---

/// モデル建物法のプログラム版。他マスタの program_version がこれを参照する。
model MasterProgramVersion {
  version     String    @id @db.VarChar(20)
  displayName String    @map("display_name") @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  releasedAt  DateTime? @map("released_at") @db.Date

  regionCategories         MasterRegionCategory[]
  modelBuildings           MasterModelBuilding[]
  buildingUses             MasterBuildingUse[]
  frameTypes               MasterFrameType[]
  glassTypes               MasterGlassType[]
  insulationInputMethods   MasterInsulationInputMethod[]
  insulationTypes          MasterInsulationType[]
  envelopeParts            MasterEnvelopePart[]
  orientations             MasterOrientation[]
  projects                 Project[]

  @@map("master_program_versions")
  @@schema("public")
}

/// 地域区分（様式 A）。sheet_value は入力シートの表記（例: 6地域）。
model MasterRegionCategory {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(100)
  displayName    String                @map("display_name") @db.VarChar(100)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@map("master_region_categories")
  @@schema("public")
}

/// 国定モデル建物。BEIm 注記は description。用途から参照される。
model MasterModelBuilding {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(100)
  displayName    String                @map("display_name") @db.VarChar(100)
  description    String?
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)
  buildingUses   MasterBuildingUse[]

  @@unique([programVersion, sheetValue])
  @@map("master_model_buildings")
  @@schema("public")
}

/// 建物用途。model_building_id で国定モデルが決まる。
model MasterBuildingUse {
  id              BigInt               @id @default(autoincrement())
  programVersion  String               @map("program_version") @db.VarChar(20)
  sheetValue      String               @map("sheet_value") @db.VarChar(200)
  displayName     String               @map("display_name") @db.VarChar(200)
  modelBuildingId BigInt               @map("model_building_id")
  sortOrder       Int                  @default(0) @map("sort_order")
  program         MasterProgramVersion @relation(fields: [programVersion], references: [version], onDelete: Restrict)
  modelBuilding   MasterModelBuilding  @relation(fields: [modelBuildingId], references: [id], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@index([modelBuildingId], map: "idx_master_building_uses_model")
  @@map("master_building_uses")
  @@schema("public")
}

/// 建具種別（様式 B1）。
model MasterFrameType {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(100)
  displayName    String?               @map("display_name") @db.VarChar(255)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@map("master_frame_types")
  @@schema("public")
}

/// ガラス符号（様式 B1）。sheet_value は 3WgG06 形式。
model MasterGlassType {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(20)
  displayName    String?               @map("display_name") @db.VarChar(255)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@map("master_glass_types")
  @@schema("public")
}

/// 断熱の入力方法。method_code は列 Y の並びどおり A〜E で固定（DEC-20）。
model MasterInsulationInputMethod {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  methodCode     String                @map("method_code") @db.Char(1)
  sheetValue     String                @map("sheet_value") @db.VarChar(50)
  displayName    String                @map("display_name") @db.VarChar(100)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, methodCode])
  @@map("master_insulation_input_methods")
  @@schema("public")
}

/// 断熱材。大分類 + 小分類。熱伝導率は小分類側に持つ。
model MasterInsulationType {
  id                   BigInt               @id @default(autoincrement())
  programVersion       String               @map("program_version") @db.VarChar(20)
  categoryMajor        String               @map("category_major") @db.VarChar(100)
  categoryMinor        String?              @map("category_minor") @db.VarChar(100)
  thermalConductivity  Decimal?             @map("thermal_conductivity") @db.Decimal(8, 4)
  sheetValueMajor      String               @map("sheet_value_major") @db.VarChar(100)
  sheetValueMinor      String?              @map("sheet_value_minor") @db.VarChar(100)
  sortOrder            Int                  @default(0) @map("sort_order")
  program              MasterProgramVersion @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValueMajor, sheetValueMinor], map: "master_insulation_types_version_major_minor_key")
  @@map("master_insulation_types")
  @@schema("public")
}

/// 外皮部位。display_name は DEC-07 が未決のため持たない。
model MasterEnvelopePart {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(50)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@map("master_envelope_parts")
  @@schema("public")
}

/// 方位。開口「なし」と外皮「屋根」「床」を同一テーブルに持つ（docs/master-data.md）。
model MasterOrientation {
  id             BigInt                @id @default(autoincrement())
  programVersion String                @map("program_version") @db.VarChar(20)
  sheetValue     String                @map("sheet_value") @db.VarChar(20)
  sortOrder      Int                   @default(0) @map("sort_order")
  program        MasterProgramVersion  @relation(fields: [programVersion], references: [version], onDelete: Restrict)

  @@unique([programVersion, sheetValue])
  @@map("master_orientations")
  @@schema("public")
}
